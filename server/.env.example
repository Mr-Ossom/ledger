# CoreLedger Paystack server env vars (set these in Vercel/Render dashboard).
#
# 1. Download the service account JSON from:
#    Firebase Console -> Project Settings -> Service accounts -> Generate new
#    private key. Then base64-encode it and paste the result here:
#      powershell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#      bash:       base64 -w0 service-account.json
# FIREBASE_SERVICE_ACCOUNT=<base64 of the JSON, no line breaks>

# 2. Paystack keys from Dashboard -> Settings -> API Keys & Webhooks (or Canvas -> Developers)
PAYSTACK_SECRET_KEY=sk_test_...