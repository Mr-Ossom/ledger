EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GROQ_API_KEY=gsk_...
EXPO_PUBLIC_GROQ_MODEL=llama-3.3-70b-versatile
# Supabase Edge secrets (set via: npx supabase secrets set BMS_API_KEY=... BMS_SENDER_ID=Ledger):
# BMS_API_KEY=bms_...
# BMS_API_URL=https://api.bmsgh.com/api/v1/send
# BMS_SENDER_ID=Ledger
# Firebase Cloud Functions base URL (no trailing slash)
# Format: https://us-central1-YOUR_FIREBASE_PROJECT_ID.cloudfunctions.net
EXPO_PUBLIC_FIREBASE_FUNCTIONS_URL=https://us-central1-YOUR_FIREBASE_PROJECT_ID.cloudfunctions.net
