# ── Firebase (required for real authentication and Firestore data) ──────────
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# ── Supabase (required for Mobile Money payments) ───────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── AI (optional; local fallbacks run without keys) ─────────────────────────
EXPO_PUBLIC_GROQ_API_KEY=gsk_...
EXPO_PUBLIC_GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallback provider:
# EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase Edge secrets (set via: npx supabase secrets set ...) ───────────
# Paystack secret key, required for Mobile Money:
# PAYSTACK_SECRET_KEY=sk_test_...
# Optional SMS/OTP provider (used only by the bms-otp/send-sms functions):
# BMS_API_KEY=bms_...
# BMS_API_URL=https://api.bmsgh.com/api/v1/send
# BMS_SENDER_ID=Ledger

# ── Legacy (not used by the current client) ─────────────────────────────────
# Firebase Cloud Functions base URL, no trailing slash:
# EXPO_PUBLIC_FIREBASE_FUNCTIONS_URL=https://us-central1-YOUR_FIREBASE_PROJECT_ID.cloudfunctions.net
